{
  "name": "@novesuite/cli",
  "description": "Command Line Interface for managing Nove API resources (Meetings, Users, etc.)",
  "version": "1.0.1",
  "author": "杨仕明",
  "bin": {
    "nove": "./bin/run.js"
  },
  "bugs": "https://github.com/lulabs-org/nove-cli/issues",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/lulabs-org/nove-cli",
  "keywords": [
    "oclif",
    "cli",
    "nove",
    "meeting",
    "management"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "nove",
    "dirname": "nove",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "meeting": {
        "description": "Manage meeting records"
      },
      "user": {
        "description": "Manage user accounts"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulabs-org/nove-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint bin src test eslint.config.mjs",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "pnpm run build && oclif manifest && oclif readme --multi",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme --multi && git add README.md docs"
  },
  "types": "dist/index.d.ts"
}